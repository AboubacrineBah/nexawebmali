{
	"name": "NexaWeb Mali",
	"image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
	"postCreateCommand": "npm ci",
	"forwardPorts": [
		5500
	],
	"portsAttributes": {
		"5500": {
			"label": "Aperçu du site",
			"onAutoForward": "openBrowser"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ritwickdey.LiveServer"
			]
		}
	}
}